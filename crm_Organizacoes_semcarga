CREATE OR REPLACE VIEW nutriplant_view.crm_Organizacoes_semcarga AS
SELECT
        ROW_NUMBER() OVER (ORDER BY vtiger_accountscf.cf_2490 DESC) AS Sequencia,
                    vtiger_account.accountname                     AS 'Nome Organização',
                    vtiger_account.account_no                      AS 'Código Organização',
                    vtiger_accountscf.cf_757                       AS 'Nome Abreviado',
                    DATE_FORMAT(vtiger_accountscf.cf_2490,'%d/%m/%Y')AS 'Alteração Classificação',
                    vtiger_accountscf.cf_781                       AS 'Classificação',
                    vtiger_account.account_type                    AS 'Tipo',
                    us.userlabel                                   AS 'Última Modificação por',
                    ua.userlabel                                   AS 'Responsável',
                    DATE_FORMAT(vtiger_account.data_do_ultimo_agendamento,'%d/%m/%Y')      AS 'Data Ultimo Agendamento',
                    DATE_FORMAT(vtiger_account.data_ult_cot_enviada,'%d/%m/%Y')            AS 'Data Ultima Cotação',
                    DATE_FORMAT(createdtime,'%d/%m/%Y')                                    AS 'Data/Hora Criação',
                    vtiger_accountscf.cf_759                       AS 'Código Cliente',
                    vtiger_account.cpfcnpj                         AS 'CPF/CNPJ',
                    vtiger_account.accountstatus                   AS 'Status Organização',
                    vtiger_account.razao_social_cnpj               AS 'Razão Social CNPJ',
                    vtiger_account.situacao_cadastral_cnpj         AS 'Situação Cadastral CNPJ',
                    DATE_FORMAT(vtiger_account.data_situacao_cadastral_cnpj,'%d/%m/%Y')    AS 'Data Situação Cadastral CNPJ',
                    vtiger_accountscf.cf_2564                      AS 'Ciclo de cotação',
                    vtiger_accountscf.cf_2557                      AS 'Dias Último Agendamento',
                    vtiger_accountscf.cf_779                       AS 'Segmento',
                    ut.userlabel                                   AS 'Responsável Conversão',
                    vtiger_accountscf.cf_2813                      AS 'Fonte Lead/Organização',
                    vtiger_accountbillads.bill_state               AS 'Estado1',
                    users.id as "id",
                    users.userlabel as "Nome Abrev"


                FROM nutriplant.vtiger_account
              
                INNER JOIN nutriplant.vtiger_accountscf ON nutriplant.vtiger_accountscf.accountid = nutriplant.vtiger_account.accountid
                INNER JOIN nutriplant.vtiger_crmentity ca ON ca.crmid = nutriplant.vtiger_account.accountid
                LEFT JOIN nutriplant.vtiger_accountbillads ON nutriplant.vtiger_accountbillads.accountaddressid = nutriplant.vtiger_account.accountid
                LEFT JOIN nutriplant.vtiger_users ua ON ua.id =ca.smownerid
                LEFT JOIN nutriplant.vtiger_users us ON us.id = ca.modifiedby
                LEFT JOIN nutriplant.vtiger_users ut ON ut.id = vtiger_account.responsavel_ultimo_agendamento_id
                LEFT JOIN nutriplant.vtiger_groups ga ON ga.groupid = ca.smownerid
                LEFT JOIN nutriplant.crm_Usuarios users on ua.userlabel  = users.userlabel
